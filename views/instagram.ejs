<%- include('includes/head.ejs') %>
  <h2>This Page belongs to @ <%= data.name %></h2>  
  <button>Follow</button>
  <button>Message</button>
  
  <h3> Followers: <%= data.followers %>&nbsp&nbsp Following: <%= data.following %></h3>
  <hr>


  <!-- post-->
 <% for (let post of data.posts){
    %>
    <img src="<%= post.image %>" alt="some image">
    <p> 
        Likes : <%= post.likes %> &nbsp;&nbsp; comments : <%= post.comments %>
    </p>
    <% } %>
    <hr>
 <%- include('includes/footer.ejs') %>
</body>
</html>